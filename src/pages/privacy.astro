---
// Privacy notice. Russian first, Kyrgyz second. Check with a lawyer before real shoppers.
import Base from '../layouts/Base.astro';
import { CONTACT } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Конфиденциальность — TAILA">
  <div class="wrap prose" style="max-width:680px;padding-top:22px;padding-bottom:40px">
    <h1 style="font-size:1.7rem">Как TAILA обращается с вашими данными</h1>
    <h2>Что мы храним</h2>
    <p>Когда вы бронируете вещь: имя, телефон, комментарий и какую вещь вы забронировали. Для защиты от
      фальшивых броней мы храним зашифрованный отпечаток вашего интернет-адреса (не сам адрес).
      У продавцов: адрес почты для входа и данные магазина, которые они сами указали.</p>
    <h2>Зачем</h2>
    <p>Чтобы магазин отложил для вас вещь и мог с вами связаться. Больше ни для чего.</p>
    <h2>Кто видит</h2>
    <p>Только магазин, в котором вы бронировали. Мы не продаём и не передаём ваши данные другим.</p>
    <h2>Где и сколько</h2>
    <p>Данные хранятся у Supabase на серверах в Европейском союзе (Франкфурт, Германия).
      Имя, телефон и комментарий удаляются через 90 дней после брони. Список ваших броней
      также хранится в вашем телефоне — его можно стереть, очистив данные браузера.</p>
    <h2>Ваши права</h2>
    <p>Отменить бронь можно на странице <a href={`${base}my/`}>«Мои брони»</a>.
      Чтобы узнать, какие данные о вас есть, исправить или удалить их, напишите нам{CONTACT ? `: ${CONTACT}` : ' через магазин, в котором вы бронировали'}.</p>

    <hr style="margin:28px 0;border:0;border-top:1px solid var(--line)">

    <h1 style="font-size:1.4rem" lang="ky">TAILA сиздин маалыматтарыңызды кантип колдонот</h1>
    <div lang="ky">
      <p>Брон кылганда: атыңыз, телефонуңуз, комментарий жана кайсы буюм. Жасалма брондордон коргоо үчүн
        интернет-дарегиңиздин шифрленген изи сакталат (дарегдин өзү эмес). Сатуучулардан: кирүү үчүн почта
        жана дүкөндүн маалыматтары.</p>
      <p>Максаты: дүкөн буюмду сизге алып коюп, сиз менен байланышышы үчүн. Маалыматтарды брон кылган дүкөн
        гана көрөт. Биз аларды сатпайбыз жана башкаларга бербейбиз.</p>
      <p>Маалыматтар Supabase'те Евробиримдиктеги серверлерде (Франкфурт, Германия) сакталат. Атыңыз,
        телефонуңуз жана комментарий брондон 90 күн өткөндөн кийин өчүрүлөт.</p>
      <p>Бронду «Менин брондорум» бетинде жокко чыгарсаңыз болот. Маалыматтарды билүү, оңдоо же өчүрүү үчүн
        бизге жазыңыз{CONTACT ? `: ${CONTACT}` : ' — брон кылган дүкөн аркылуу'}.</p>
    </div>
  </div>
</Base>
